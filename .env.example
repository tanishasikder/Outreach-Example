# Copy to .env for local development. On AWS, .env is written by deploy/fetch_env.sh
# from SSM Parameter Store (/outreach/*), so never copy secrets to the server by hand.

# --- App
JWT_SECRET_KEY=change-me                # signs login tokens (python -m src.schemas.jwt makes one)
REDIS_URL=redis://localhost:6379
GOOGLE_API_KEY=                         # Gemini, for the sales report
QDRANT_URL=                             # Qdrant Cloud cluster, for the sales tips
QDRANT_KEY=
# CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# MODEL_REFRESH_SECONDS=300             # how often the worker checks for a newly promoted model

# --- Storage. Leave S3_BUCKET empty locally: models and data then go to artifacts/
S3_BUCKET=
AWS_REGION=us-east-1
DBT_TARGET=local                        # "aws" reads raw CSVs from s3://<S3_BUCKET>/raw/

# --- Airflow (only used by airflow/compose.yaml; local defaults are fine)
# AIRFLOW_ADMIN_PASSWORD=airflow
# AIRFLOW_DB_PASSWORD=airflow
# AIRFLOW_JWT_SECRET=
# AIRFLOW_FERNET_KEY=

# --- Caddy (deploy/compose.yaml)
# SITE_ADDRESS=:80                      # or your domain name, for automatic HTTPS
