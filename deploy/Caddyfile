{$SITE_ADDRESS::80} {
	encode gzip

	# /api/upload -> http://api:8000/upload (the /api prefix is removed)
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Everything else is the frontend
	handle {
		root * /srv
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
